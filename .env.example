# CivicLens AI Mobile Configuration
# Copy this file to .env or .env.local to customize your backend endpoint.

# For Android Emulator:
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# For Physical Android Phone:
# Replace with your computer's local network IPv4 address (run 'ipconfig' on Windows):
# EXPO_PUBLIC_API_URL=http://192.168.1.15:8000

# For iOS Simulator / Web:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
